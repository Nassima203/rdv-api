# Copie ce fichier en ".env" pour le développement local (le vrai .env n'est jamais mis sur GitHub).
# En production, ces valeurs se règlent dans les variables d'environnement de Render.

# Clé admin du salon : c'est elle qu'on tape sur l'écran de connexion de l'espace salon (/admin).
# Choisissez une longue phrase secrète (au moins 20 caractères).
ADMIN_API_KEY=change-moi

# Base PostgreSQL (Neon). Vide = fichier SQLite local rdv.db
DATABASE_URL=

# Relais email Gmail (voir docs/relais-email.gs). Vide = pas d'email, la réservation marche quand même
MAIL_RELAY_URL=
MAIL_RELAY_SECRET=
SITE_URL=https://maison-lumen-c4b75a.webflow.io

# Sites autorisés à appeler l'API depuis un navigateur (séparés par des virgules)
ALLOWED_ORIGINS=https://maison-lumen-c4b75a.webflow.io,http://localhost:8000

# Fuseau horaire du salon (sinon le serveur compte en UTC)
TZ=Europe/Paris

# Limites anti-abus (format : nombre/période)
LIMITE_RESERVATION=5/hour
LIMITE_PAR_DEFAUT=120/minute

# Nombre de jours à l'avance où l'on peut réserver
JOURS_RESERVABLES=60
